APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email — required for Super Admin 2FA codes and password-reset OTPs.
# 'log' writes the code to storage/logs instead of sending (dev only).
# For production on cPanel, create a mailbox (e.g. noreply@yourdomain) and
# use its SMTP settings from cPanel → Email Accounts → Connect Devices:
#   MAIL_MAILER=smtp
#   MAIL_HOST=mail.yourdomain.com      (the exact host cPanel shows)
#   MAIL_PORT=465                       (465 = SSL, or 587 = TLS)
#   MAIL_USERNAME=noreply@yourdomain.com
#   MAIL_PASSWORD=the-mailbox-password
#   MAIL_ENCRYPTION=ssl                 (ssl for 465, tls for 587)
#   MAIL_FROM_ADDRESS=noreply@yourdomain.com
# Recovery: set ADMIN_2FA=false to bypass the OTP if mail is unavailable.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Super Admin two-factor (emailed OTP). Set false to bypass in an emergency.
ADMIN_2FA=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
